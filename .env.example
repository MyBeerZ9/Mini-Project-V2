# Environment Configuration Example for CARVIA Car Rental System
# Copy this file or set these environment variables in your system / deployment.

# ==========================================
# 1. Google Gemini API Key
# Get a free key from: https://aistudio.google.com/
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 2. Supabase PostgreSQL Database Settings
# Find these under your Supabase Project Settings -> Database -> Connection string (JDBC)
# ==========================================
DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ==========================================
# 3. Allowed Frontend Origins (Optional)
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
